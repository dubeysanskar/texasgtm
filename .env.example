# GTM CRM — Environment Variables
# Copy this to .env and fill in your values

# ═══ Database ═══
# Option A — SQLite (zero-config, default). Leave DATABASE_URL unset, or point it at a file:
#DATABASE_URL=sqlite:./data/gtm.db
# Option B — PostgreSQL (self-hosted on the server, or any managed Postgres):
#DATABASE_URL=postgresql://gtm:CHANGE_ME@127.0.0.1:5432/gtm_crm
# For a Postgres server without TLS (typical for localhost) SSL is skipped automatically; force it off with:
#DATABASE_SSL=false

# JWT secret for auth tokens (generate a random 32+ char string)
JWT_SECRET=change-this-to-a-random-secret-string

# ═══ SMTP Account 1 (Primary) — used for OTP / invites when no SMTP accounts exist in Admin → Email / SMTP ═══
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@domain.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@domain.com
SMTP_FROM_NAME=GTM CRM
SMTP_DAILY_LIMIT=30

# ═══ SMTP Account 2 / 3 (Rotation, optional) ═══
# SMTP2_HOST=smtp.gmail.com
# SMTP2_PORT=465
# SMTP2_SECURE=true
# SMTP2_USER=your-second-email@domain.com
# SMTP2_PASSWORD=your-second-app-password
# SMTP2_FROM=your-second-email@domain.com
# SMTP2_FROM_NAME=GTM CRM
# SMTP2_DAILY_LIMIT=30

# App
APP_URL=http://localhost:3000

# Lead scraper API keys (optional)
#TWOGIS_API_KEY=
#SUPERJOB_API_KEY=
#GOOGLE_MAPS_API_KEY=

# Auto Email — LLM Personalization (optional). Also powers the "Translate" button
# on Daily Updates entries — without this key, translation shows a friendly "not configured" message.
#OPENAI_API_KEY=sk-your-openai-api-key-here

# Daily work log reminder loop — override the interval (ms) the follow-up reminder loop runs at (default 60000)
#FOLLOWUP_REMINDER_INTERVAL_MS=60000
